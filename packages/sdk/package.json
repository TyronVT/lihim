{
  "name": "@lihim/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Lihim: anonymous group membership and polls built on Semaphore V4 and Soroban.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prover": {
      "types": "./dist/prover.d.ts",
      "import": "./dist/prover.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@semaphore-protocol/group": "^4.14.5",
    "@semaphore-protocol/identity": "^4.14.5",
    "@semaphore-protocol/proof": "^4.14.5",
    "@stellar/stellar-sdk": "^17.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ethers": "^6.13.4",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
