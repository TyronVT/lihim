# Secret key (S...) of the account that pays fees for vote transactions.
# This is "fee key #2" in the spec: separate from the admin-tx fee key held in
# Supabase secrets, so it can be rotated or drained-capped on its own.
# Fund it with a small amount only; it is the relay's ONLY secret.
RELAY_FEE_SECRET=

# Soroban RPC endpoint and the network it serves.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed LihimPolls contract (C...).
POLLS_CONTRACT_ID=

# The one browser origin allowed to call the relay (exact match, no trailing slash).
APP_ORIGIN=http://localhost:3000

# Upper bound for the random pre-submit delay, in ms. 0 disables it.
# The spec suggests up to 60000 for small groups; the response waits for it.
RELAY_MAX_DELAY_MS=0

# Local server only (ignored on Vercel).
PORT=8787

# Optional: invalid votes tolerated per poll per minute before the relay stops
# simulating for that poll for the rest of the minute. Default 60.
# RELAY_INVALID_PER_POLL_PER_MIN=60
