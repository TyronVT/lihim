# Public origin of this app (used for metadataBase / OG URLs and invite links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data layer: "mock" (default, in-memory demo data) or "supabase" (lib/data/supabase.ts skeleton;
# needs @supabase/supabase-js installed — see that file).
NEXT_PUBLIC_DATA=

# Prover: "mock" (default, fake proof with simulated timing) or "sdk" (real Semaphore proof in a
# Web Worker via @lihim/sdk/prover). Dev builds also accept ?prover=sdk on any /p/<poll> URL.
# Until passkeys exist, "sdk" uses a FIXED DEV-ONLY PRF output (lib/identity.ts) outside production.
NEXT_PUBLIC_PROVER=

# Supabase (app data + auth). Only used when NEXT_PUBLIC_DATA=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vote relay (apps/relay). Separate origin on purpose: no cookies, no session ever reach it.
# Leave empty to use the in-browser mock relay during UI development.
NEXT_PUBLIC_RELAY_URL=

# Stellar RPC used by the public verify page (L9) to recount straight from the public record.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_LIHIM_POLLS_CONTRACT_ID=
NEXT_PUBLIC_LIHIM_SEMAPHORE_CONTRACT_ID=

# Public explorer base for the L9 footnote link (tx hashes are appended).
NEXT_PUBLIC_EXPLORER_TX_URL=https://stellar.expert/explorer/testnet/tx/

# Set to "1" to expose /dev/components in production builds.
NEXT_PUBLIC_ENABLE_DEV_ROUTES=
