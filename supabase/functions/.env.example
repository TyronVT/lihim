# Edge Function secrets. Local: `supabase functions serve --env-file supabase/functions/.env`
# Hosted: `supabase secrets set --env-file supabase/functions/.env`
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the runtime.

# Browser origin(s) of the PWA, comma-separated. Used for CORS and as the WebAuthn expected origin.
APP_ORIGIN=http://localhost:3000

# WebAuthn relying party (the PWA's registrable domain, no scheme/port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Lihim
# Synthetic, undeliverable email domain for passkey-only accounts.
PASSKEY_EMAIL_DOMAIN=passkey.lihim.invalid

# Stellar
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Same names contracts/scripts/deploy-testnet.sh prints.
LIHIM_SEMAPHORE_ID=
LIHIM_POLLS_ID=
# Optional: lets the keeper also keep the verifier's instance, code and Vk entries alive.
LIHIM_VERIFIER_ID=

# Fee key #1 (admin txs + keeper). NOT the relay's vote fee key.
ADMIN_FEE_SECRET=

# Must equal the Vault secret lihim_cron_secret (see migrations/*_schedules.sql).
CRON_SECRET=

# Indexer: first ledger to scan when there is no cursor (contract deploy ledger).
INDEXER_START_LEDGER=0
INDEXER_VERIFY_ROOTS=true

# Keeper TTL policy, in ledgers (~17,280/day).
KEEPER_EXTEND_TO_LEDGERS=2073600
KEEPER_THRESHOLD_LEDGERS=518400

# Web push (generate with `npx web-push generate-vapid-keys`).
VAPID_SUBJECT=mailto:hello@lihim.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
